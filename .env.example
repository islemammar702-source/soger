# ─── Obligatoire ──────────────────────────────────────────────────────
# Base de données PostgreSQL
# - Production : chaîne de connexion Neon (…-pooler…neon.tech…), driver serverless utilisé automatiquement
# - Local      : postgres://postgres@localhost:5432/soger
DATABASE_URL=

# URL publique du site (liens des documents envoyés aux clients, métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de signature des liens de documents (devis / factures envoyés aux clients).
# Générez une longue valeur aléatoire, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ─── Facultatif ───────────────────────────────────────────────────────
# Envoi des images produits vers Cloudinary : cloudinary://CLÉ:SECRET@NOM_DU_CLOUD
CLOUDINARY_URL=

# Envoi des devis par e-mail via Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=SOGER <devis@votre-domaine.tn>

# Tests d'intégration (base de TEST uniquement, transactions annulées)
TEST_DATABASE_URL=
